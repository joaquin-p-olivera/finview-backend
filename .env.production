# Database
DATABASE_URL=

# JWT Secret
SECRET_KEY=

# API Keys
ANTHROPIC_API_KEY=
PURCHASE_AI_MODEL=claude-opus-5-5
STATEMENT_PARSER_MODEL=claude-sonnet-5

# CORS Origins - comma separated
CORS_ORIGINS=

# Upload settings (PDFs are kept in memory only)
MAX_FILE_SIZE_MB=20

# External import endpoint (restricts POST /api/v1/statements/external)
EXTERNAL_IMPORT_SECRET=
EXTERNAL_IMPORT_ALLOWED_EMAIL=

# Import by email: a Gmail account (2-step verification + app password) users
# forward their bank emails to, read over IMAP; an external cron calls
# POST /api/v1/email-import/run with the X-Cron-Secret header
EMAIL_IMPORT_ADDRESS=
EMAIL_IMPORT_APP_PASSWORD=
EMAIL_IMPORT_IMAP_HOST=imap.gmail.com
EMAIL_IMPORT_CRON_SECRET=
