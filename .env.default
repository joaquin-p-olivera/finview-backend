# Database
DATABASE_URL=

# JWT Secret
SECRET_KEY=

# API Keys
ANTHROPIC_API_KEY=
PURCHASE_AI_MODEL=claude-opus-5-5
PURCHASE_ASK_MODEL=claude-opus-5-5
PURCHASE_ASK_DAILY_LIMIT=20
STATEMENT_PARSER_MODEL=claude-sonnet-5

# CORS Origins - comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload settings (PDFs are kept in memory only)
MAX_FILE_SIZE_MB=20

# External import endpoint (restricts POST /api/v1/statements/external)
EXTERNAL_IMPORT_SECRET=
EXTERNAL_IMPORT_ALLOWED_EMAIL=

# Import by email: a Gmail account (2-step verification + app password; can be
# an existing one, only mail sent to its +TOKEN addresses is touched) users
# forward their bank emails to, read over IMAP; an external cron calls
# POST /api/v1/email-import/run with the X-Cron-Secret header
EMAIL_IMPORT_ADDRESS=
EMAIL_IMPORT_APP_PASSWORD=
EMAIL_IMPORT_IMAP_HOST=imap.gmail.com
EMAIL_IMPORT_CRON_SECRET=

# Notice email sent when a statement arrives: through Resend over HTTPS when
# RESEND_API_KEY is set (Render's free plan blocks SMTP ports); otherwise
# through the import inbox's Gmail SMTP. Without a verified domain Resend only
# delivers to the email of your Resend account
RESEND_API_KEY=
RESEND_FROM=Finview <onboarding@resend.dev>

# Login with Google: OAuth client ID (type "Web application") from Google Cloud
# Console, with the frontend URLs as authorized JavaScript origins. Empty = off
GOOGLE_CLIENT_ID=
