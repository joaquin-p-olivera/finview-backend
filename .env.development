# Database
DATABASE_URL=mysql+pymysql://root@localhost:3306/gastos_db

# JWT Secret
SECRET_KEY=""

# API Keys
ANTHROPIC_API_KEY=""
STATEMENT_PARSER_MODEL=claude-sonnet-5

# CORS Origins - comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload settings (PDFs are kept in memory only)
MAX_FILE_SIZE_MB=20

# External import endpoint (restricts POST /api/v1/statements/external)
EXTERNAL_IMPORT_SECRET=
EXTERNAL_IMPORT_ALLOWED_EMAIL=
